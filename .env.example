# Razorpay Test Mode credentials
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your own test credentials from Razorpay Dashboard > Account & Settings > Websites & API keys
# 3. Never commit .env to version control (it's in .gitignore)

# Your test Key ID (starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id

# Your test Key Secret (shown once when you click "View test API keys")
RAZORPAY_KEY_SECRET=your_test_secret

# Webhook secret — create one in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Server
PORT=3000
NODE_ENV=development

# Admin password — change before sharing
ADMIN_PASSWORD=change-me

# Data file
DATA_FILE=./data/demo.json